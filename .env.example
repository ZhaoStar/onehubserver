# 数据库
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=onehub

# JWT
SECRET_KEY=change-me-to-a-random-secret-key

# 调试模式
DEBUG=true

# —————— 视频转MP3 ——————
# FFmpeg 路径（留空则自动探测）
FFMPEG_PATH=
# 上传目录，留空则使用项目根目录下的 uploads/
UPLOAD_DIR=
# 单次上传视频大小上限（MB）
MAX_VIDEO_SIZE_MB=500
# 默认音频比特率
DEFAULT_AUDIO_BITRATE=192k
# 默认采样率
DEFAULT_SAMPLE_RATE=44100
# 默认声道数
DEFAULT_AUDIO_CHANNELS=2
